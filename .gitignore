# ===========================
# .gitignore para proyectos .NET
# ===========================

# Carpetas de build
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
[Dd]ebug/
[Rr]elease/
[Dd]ebugPublic/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
msbuild.log
msbuild.err
msbuild.wrn

# Resultados de pruebas
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.svclog
*.scc
*.psess
*.vsp
*.vspx
*.sap

# Rider / JetBrains
.idea/
*.sln.iml

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Archivos de publicación / despliegue
[Pp]ublish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Caches
*.cache
*.tlog
*.lastbuildstate
project.lock.json
project.fragment.lock.json
artifacts/

# Archivos sensibles / secretos
appsettings.*.json
!appsettings.json
!appsettings.Development.json
*.pfx
*.snk
secrets.json
.env
.env.local
.env.*.local

# Entity Framework
*.edmx.diagram
*.edmx.sql

# ASP.NET / web
wwwroot/dist/
node_modules/
bower_components/

# Otros
*.swp
*.tmp
*.bak
*.orig
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pidb
